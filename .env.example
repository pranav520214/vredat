# Vredat (Verdeta) Environment Template
# Configure local Ollama or optional remote backends

# Ollama Host Endpoint
OLLAMA_HOST=http://localhost:11434

# Primary Models
SYSTEM1_MODEL=laya-fast-intent
SYSTEM2_CODE_MODEL=llama3.2:1b
FALLBACK_CODE_MODEL=qwen2.5-coder:1.5b-instruct

# Ponytail Memory Settings
PONYTAIL_LADDER_MODE=Full
MAX_CONTEXT_TOKENS=8192
DECISION_LEDGER_PATH=.vredat/memory.json
